# ==========================================
# STAGE 1: Dependency Installation & Build
# ==========================================
FROM node:20-alpine AS dependencies

WORKDIR /app

# Copy dependency manifests first to leverage Docker layer caching
COPY package*.json ./

# Install ONLY production dependencies (prunes devDependencies like Vite/types)
RUN npm ci --omit=dev

# ==========================================
# STAGE 2: Production Runtime
# ==========================================
FROM node:20-alpine AS runner

WORKDIR /app

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=5000

# Copy node_modules from the dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/package*.json ./

# Copy application source code
COPY . .

# Use built-in non-privileged 'node' user for security
USER node

# Expose the port Express is configured to listen on
EXPOSE 5000

# Start the receiver server
CMD ["node", "slop/receiver.js"]